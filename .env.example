# Copy file này thành ".env" rồi điền API key. KHÔNG đưa file .env lên GitHub.

# Chọn nhà cung cấp AI: gemini hoặc claude
AI_PROVIDER=gemini

# Lấy key Gemini tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hoặc key Claude tại: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# (Không bắt buộc) đổi model, mặc định: gemini-flash-latest / claude-haiku-5-5
AI_MODEL=

# Cổng của server AI
AI_PORT=3001
