# Copy file này thành ".env" rồi điền key. KHÔNG đưa file .env lên GitHub.

# ===== AI tư vấn hoa =====
# Chọn nhà cung cấp AI: gemini hoặc claude
AI_PROVIDER=gemini
# Lấy key Gemini tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Hoặc key Claude tại: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# (Không bắt buộc) đổi model, mặc định: gemini-flash-latest / claude-haiku-5-5
AI_MODEL=

# ===== Thanh toán payOS =====
# Đăng ký tại https://my.payos.vn -> Kênh thanh toán -> lấy 3 khóa bên dưới
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ===== Địa chỉ =====
# Cổng của backend (AI + payOS)
BACKEND_PORT=3001
# json-server và web Angular
JSON_SERVER_URL=http://localhost:3000
WEB_URL=http://localhost:4200
